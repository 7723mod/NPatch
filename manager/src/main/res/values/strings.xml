    <string name="about_author_summary">NPatch maintainer</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer_body">NPatch is provided only for learning, research, and legitimate app compatibility work. Please respect local laws, app terms, and the rights of original developers. You are responsible for how patched apps and modules are used on your device.</string>
