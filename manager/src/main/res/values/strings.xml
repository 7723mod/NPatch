    <string name="patch_mode">Patch Mode</string>
    <string name="patch_local">Local</string>
    <string name="patch_local_desc">Patches apps without embedding modules.\nThe Xposed scope can be dynamically changed without needing to re-patch.\nThis mode can only be used locally with the NPatch Manager.</string>
    <string name="patch_integrated">Integrated</string>
    <string name="patch_integrated_desc">Patches apps with built-in modules.\nThe patched app can run independently without the Manager, but it cannot dynamically manage configurations.\nThis mode is suitable for apps that need to run on devices without the NPatch Manager installed.</string>
    <string name="patch_embed_modules">Embed modules</string>
    <string name="patch_advanced">Advanced options</string>
    <string name="patch_debuggable">Debuggable</string>
    <string name="patch_sigbypass">Signature bypass</string>
    <string name="patch_sigbypasslv0">None</string>
    <string name="patch_sigbypasslv0_desc">No processing performed</string>
    <string name="patch_sigbypasslv1">Basic</string>
    <string name="patch_sigbypasslv1_desc">Adds Java IO and native openat/openat64 redirection so signature-related file reads use the original APK</string>
    <string name="patch_sigbypasslv2">High</string>
    <string name="patch_sigbypasslv2_desc">Builds on Basic by restoring the original AppComponentFactory and hooking getPackageArchiveInfo / hasSigningCertificate for stricter verification paths</string>
    <string name="patch_sigbypasslv3">Extreme</string>
    <string name="patch_sigbypasslv3_desc">Builds on High by hooking the PackageInfo(Parcel) constructor so signatures are replaced across binder unparceling paths</string>
    <string name="patch_sigbypasslv4">Seccomp</string>
    <string name="patch_sigbypasslv4_desc">Enables seccomp v2 filtering and trusted-thread file redirection on ARM64, referencing the implementation approach used by FunPatchApp</string>
    <string name="patch_new_package">Patch New PackageName</string>
    <string name="hint_patch_new_package">Input a new package for app</string>
    <string name="patch_override_version_code">Override version code</string>
    <string name="patch_override_version_code_desc">Override the patched app\'s version code with a custom value, defaulting to 1.\nThis allows downgrade installation in more cases, and generally does not affect the version code actually perceived by the application</string>
    <string name="patch_custom_version_code">Custom version code</string>
    <string name="patch_inject_mt_provider">Inject Files Provider</string>
    <string name="patch_inject_mt_provider_desc">Inject file providers to manage files in the data directory without root privileges (From MT Manager)</string>
    <string name="patch_use_microg">Force enable MicroG support</string>
    <string name="patch_use_microg_desc">Redirect GMS requests to the community version of MicroG (such as ReVanced GmsCore). Applicable to Google apps like YouTube, requires manually installing the corresponding MicroG service.</string>
    <string name="patch_output_log_to_media">Output Log to Media Directory</string>
    <string name="patch_output_log_to_media_desc">Output the Xposed logs and framework startup logs of the module running to the Media directory.</string>
    <string name="patch_hide_libs">Exempt environment checks</string>
    <string name="patch_hide_libs_desc">Sanitize ART and sensitive system library visibility for apps that perform basic runtime environment checks.</string>
