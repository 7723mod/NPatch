    <!-- Welcome Screen -->
    <string name="welcome_version">Version %1$s</string>
    <string name="welcome_intro_content">A modern Xposed module injection and APK patching tool designed for rootless environments.</string>
    <string name="welcome_intro_detail">NPatch injects the Xposed loader by modifying APK files. Local mode works with the manager to load modules and manage scopes dynamically, without keeping the manager running in the background. Integrated mode embeds modules directly into the target app for standalone use on devices without the manager. Shizuku only unlocks some convenience features and is not required for NPatch core patching, module loading, or basic management.</string>
    <string name="welcome_permission_title">Configure Required Permissions</string>
    <string name="welcome_permission_summary">Before getting started, grant basic access permissions to keep core features working.</string>
    <string name="welcome_permission_storage_title">Storage Access</string>
    <string name="welcome_permission_storage_summary">Used to select local APK files for patching and save output results to external storage.</string>
    <string name="welcome_permission_applist_title">Read App List</string>
    <string name="welcome_permission_applist_summary">Used to read installed apps so you can choose patch targets accurately.</string>
    <string name="welcome_optional_title">Optional extension: Shizuku</string>
    <string name="welcome_optional_summary">Optional extension only. Even without Shizuku, NPatch core features still work normally.</string>
    <string name="welcome_permission_granted">Granted</string>
    <string name="welcome_permission_authorize">Grant access</string>
    <string name="welcome_disclaimer_title">Usage Notes and Disclaimer</string>
    <string name="welcome_disclaimer_summary">Before patching apps or loading Xposed modules, make sure you understand the following risks.</string>
    <string name="welcome_disclaimer_content">Modifying and patching apps may cause crashes, startup failures, or data loss. Back up important data before operating. Users are responsible for all risks and consequences of running patched apps and modules on their devices.</string>
