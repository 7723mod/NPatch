    <!-- Welcome Screen -->
    <string name="welcome_version">喵喵版本 %1$s</string>
    <string name="welcome_intro_content">专为免 Root 环境设计的现代化 Xposed 模组注入与应用修补小窝喵。</string>
    <string name="welcome_intro_detail">NyaPatch 能在免 Root 环境中，透过修改 APK 档案注入 Xposed 载入器。居家模式需搭配管理器动态载入并管理模组与作用域，但使用时无需保持管理器处于背景运行；合体模式则将模组直接内嵌至目标应用中，适合无管理器的装置独立执行喵。</string>
    <string name="welcome_permission_title">配置必要权限喵</string>
    <string name="welcome_permission_summary">开始体验前，请先授予基本存取权限以确保核心功能运作喵。</string>
    <string name="welcome_permission_storage_title">储存空间存取喵</string>
    <string name="welcome_permission_storage_summary">用于选取本机 APK 档案进行修补，并将输出结果储存至外部储存空间喵。</string>
    <string name="welcome_permission_applist_title">读取应用程式清单喵</string>
    <string name="welcome_permission_applist_summary">用于获取已安装的应用程式，以便您精确选取修补目标喵。</string>
    <string name="welcome_permission_granted">已授予喵</string>
    <string name="welcome_permission_authorize">前往授权喵</string>

    <string name="welcome_disclaimer_title">使用须知与免责声明喵</string>
    <string name="welcome_disclaimer_summary">在修补应用或载入 Xposed 模组之前，请务必了解以下操作风险喵。</string>
    <string name="welcome_disclaimer_content">修改与修补应用程式可能导致其闪退、无法启动或资料遗失。请务必在操作前备份重要资料。使用者需自行承担修补后应用及模组在装置上执行的一切风险与后果喵。</string>
